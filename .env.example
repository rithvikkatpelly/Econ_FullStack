# Copy this file to .env and fill in your own keys.

# --- FRED (the MCP server + live data) ----------------------------------
# Get a free key at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# Serve FRED calls from the built-in synthetic fixture instead of the network.
# Leave unset for "auto" (offline only when FRED_API_KEY is missing); set 1/0
# to force. The evaluation harness and tests force offline themselves.
# FRED_OFFLINE=1

# --- News (src/news_client.py) -----------------------------------------
# Get a free key at https://newsapi.org/register (Developer tier: 100
# requests/day, articles from roughly the last month — see README "Why
# NewsAPI.org"). Same offline-fixture pattern as FRED_OFFLINE.
NEWS_API_KEY=your_newsapi_org_key_here
# NEWS_OFFLINE=1

# --- Multi-agent orchestrator (src/agents) -----------------------------
# "stub"      -> deterministic offline planner (default; no key, no cost)
# "gemini"    -> real Gemini function-calling loop (Gemini API or Vertex AI)
# "anthropic" -> real Claude tool-use loop (needs ANTHROPIC_API_KEY)
AGENT_BACKEND=stub

# Gemini — either an API key from https://aistudio.google.com/apikey ...
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
# ... or Vertex AI with your gcloud credentials (`gcloud auth application-default
# login`) / the Cloud Run service account. No key needed in this mode.
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=global

ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-opus-5

# --- Guardrails --------------------------------------------------------
# Rough per-session token budget guardrail (see src/cost_tracker.py)
SESSION_TOKEN_BUDGET=50000

# MCP-boundary rate limit (see src/rate_limit.py)
TOOL_RATE_LIMIT_PER_MIN=120
TOOL_RATE_LIMIT_BURST=30

# Per-worker retry on a transient error (rate limit / provider 5xx / blip)
# before the orchestrator skips/degrades that source. Backoff is 0 by default
# so the test suite stays instant; a real deploy might set 250.
AGENT_RETRY_ATTEMPTS=2
AGENT_RETRY_BACKOFF_MS=0

# Idempotency cache (src/cache.py). ":memory:" (default) keeps nothing on
# disk; point at a file to persist across restarts / share across processes.
# CACHE_PATH=.cache/econ_agent.sqlite
FRED_CACHE_TTL_SECONDS=86400
NEWS_CACHE_TTL_SECONDS=3600

# --- HTTP API (backend/app) ------------------------------------------
# Comma-separated origins allowed to call the API from a browser. Defaults
# to the local Vite dev server; add your deployed frontend's URL in prod.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Spend guards on POST /agent/ask and /agent/stream (backend/app/agent.py).
# AGENT_RATE_LIMIT_PER_MIN=6
# AGENT_RATE_LIMIT_BURST=3
# AGENT_MAX_CONCURRENT_RUNS=2
# AGENT_MAX_QUERY_CHARS=500
